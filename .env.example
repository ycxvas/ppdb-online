# Tambahkan (atau sesuaikan) baris berikut di file .env proyek Laravel-mu.
# Jangan commit file .env asli.

# Bahasa Indonesia (nama bulan dan pesan validasi)
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

# Akun admin yang dibuat oleh seeder
ADMIN_NAMA="Admin PPDB"
ADMIN_EMAIL=admin@contoh.sch.id
# Kosongkan agar seeder membuat sandi acak dan menampilkannya di terminal
ADMIN_PASSWORD=
